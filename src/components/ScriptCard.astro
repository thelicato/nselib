---
interface Props {
	title: string;
	href: string;
	source: 'official' | 'unofficial';
	category: string;
	shortDescription: string;
	tags: string[];
	ports: string[];
	protocols: string[];
}

const { title, href, source, category, shortDescription, tags, ports, protocols } = Astro.props;

const sourceLabel = source === 'official' ? 'Official' : 'Unofficial';
const sourceClasses =
	source === 'official'
		? 'border-emerald-400/30 bg-emerald-400/10 text-emerald-100'
		: 'border-amber-400/30 bg-amber-400/10 text-amber-100';
---

<article
	class="group h-full rounded-[2rem] border border-white/10 bg-white/5 p-6 shadow-[0_20px_80px_rgba(3,8,20,0.35)] backdrop-blur"
	data-script-card
>
	<div class="flex items-start justify-between gap-4">
		<div>
			<p class="text-xs uppercase tracking-[0.3em] text-slate-400">{category}</p>
			<h3 class="mt-3 text-2xl font-semibold text-white">{title}</h3>
		</div>
		<span class={`rounded-full border px-3 py-1 text-xs font-medium ${sourceClasses}`}>
			{sourceLabel}
		</span>
	</div>

	<p class="mt-4 text-sm leading-7 text-slate-300">{shortDescription}</p>

	<div class="mt-6 flex flex-wrap gap-2">
		{tags.map((tag) => (
			<span class="rounded-full border border-cyan-400/20 bg-cyan-400/10 px-3 py-1 text-xs text-cyan-100">
				#{tag}
			</span>
		))}
	</div>

	<div class="mt-6 flex flex-wrap gap-3 text-sm text-slate-300">
		<span class="rounded-full border border-white/10 bg-slate-950/60 px-3 py-2">
			Ports: {ports.length ? ports.join(', ') : 'Any'}
		</span>
		<span class="rounded-full border border-white/10 bg-slate-950/60 px-3 py-2">
			Protocols: {protocols.length ? protocols.join(', ') : 'n/a'}
		</span>
	</div>

	<a
		class="mt-8 w-full inline-flex items-center justify-center gap-2 rounded-2xl border border-cyan-400/25 bg-cyan-400/12 px-4 py-3 text-sm font-medium text-cyan-100 transition hover:border-cyan-300/40 hover:bg-cyan-400/18 hover:text-white"
		href={href}
	>
		View Script Details
		<span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-slate-950/80 text-cyan-200" aria-hidden="true">
			<svg viewBox="0 0 16 16" class="h-3.5 w-3.5 fill-none stroke-current" xmlns="http://www.w3.org/2000/svg">
				<path d="M5.5 3.5L10 8L5.5 12.5" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</span>
	</a>
</article>
