---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	ogType?: 'website' | 'article';
	image?: string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title = 'NSE Library',
	description = 'Browse official and unofficial Nmap NSE scripts in a searchable static reference library.',
	ogType = 'website',
	image = '/logo.png',
	jsonLd
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.nselib.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();
const jsonLdPayload = jsonLd
	? JSON.stringify(Array.isArray(jsonLd) ? jsonLd : [jsonLd])
	: '';
---

<!doctype html>
<html lang="en" class="bg-slate-950 text-slate-100">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/logo.png" />
		<link rel="apple-touch-icon" href="/logo.png" />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="theme-color" content="#020617" />
		<meta property="og:site_name" content="NSE LIB" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:alt" content="NSE LIB logo" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<title>{title}</title>
		{jsonLdPayload && <script type="application/ld+json" set:html={jsonLdPayload} />}
	</head>
	<body class="min-h-screen bg-[radial-gradient(circle_at_top,rgba(34,211,238,0.18),transparent_38%),linear-gradient(180deg,#020617_0%,#0f172a_45%,#020617_100%)]">
		<slot />
		<footer class="w-full border-t border-white/10 bg-slate-950/70 px-6 pb-10 pt-10 backdrop-blur sm:px-8 lg:px-10">
			<div class="mx-auto max-w-7xl">
				<p class="text-xs uppercase tracking-[0.35em] text-slate-400">Contribute</p>
				<h2 class="mt-4 text-2xl font-semibold text-white">Help expand the NSE Library.</h2>
				<div class="mt-6 grid gap-8 lg:grid-cols-5 lg:items-start">
					<div class="lg:col-span-3">
						<p class="max-w-4xl text-sm leading-7 text-slate-300">
							Add new scripts, improve metadata, refine descriptions, and help keep the library
							useful for everyone working with NSE. Contributions are welcome.
						</p>
						<p class="max-w-4xl text-sm leading-7 text-slate-300 mt-4">
							All scripts belong to their respective owners.
						</p>
						<a
							class="mt-3 inline-flex text-sm font-medium text-cyan-200 transition hover:text-white"
							href="/privacy-policy"
						>
							Privacy Policy
						</a>
					</div>
					<div class="border-t border-white/10 pt-8 lg:col-span-2 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
						<p class="text-sm leading-7 text-slate-300">
							This project is open source under the MIT License and available on GitHub.
						</p>
						<div class="mt-6">
							<a
								class="inline-flex w-full items-center justify-center gap-3 rounded-2xl border border-cyan-400/25 bg-cyan-400/12 px-4 py-3 text-sm font-medium text-cyan-100 transition hover:border-cyan-300/40 hover:bg-cyan-400/18 hover:text-white"
								href="https://github.com/thelicato/nselib"
								target="_blank"
								rel="noreferrer"
							>
								<svg
									viewBox="0 0 24 24"
									class="h-5 w-5 fill-current"
									aria-hidden="true"
									xmlns="http://www.w3.org/2000/svg"
								>
									<path d="M12 .5C5.65.5.5 5.65.5 12.02c0 5.1 3.3 9.43 7.88 10.95.58.11.79-.25.79-.56 0-.27-.01-1.18-.02-2.14-3.2.7-3.88-1.36-3.88-1.36-.53-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.71.08-.71 1.16.08 1.76 1.2 1.76 1.2 1.03 1.76 2.69 1.25 3.34.96.1-.74.4-1.25.72-1.54-2.56-.29-5.25-1.28-5.25-5.72 0-1.26.45-2.28 1.19-3.08-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.19 1.18a10.93 10.93 0 0 1 5.8 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.77.11 3.06.74.8 1.18 1.82 1.18 3.08 0 4.45-2.69 5.42-5.26 5.7.41.36.77 1.05.77 2.13 0 1.54-.02 2.78-.02 3.16 0 .31.21.68.8.56 4.57-1.53 7.86-5.86 7.86-10.95C23.5 5.65 18.35.5 12 .5Z"></path>
								</svg>
								View on GitHub
							</a>
						</div>
					</div>
				</div>
			</div>
		</footer>
	</body>
</html>
