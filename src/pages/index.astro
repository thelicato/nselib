---
import { getCollection } from 'astro:content';

import LibrarySection from '../components/LibrarySection.astro';
import Layout from '../layouts/Layout.astro';

const scripts = (await getCollection('scripts')).sort((a, b) =>
	a.data.title.localeCompare(b.data.title)
);

const officialScripts = scripts.filter((script) => script.data.source === 'official');
const unofficialScripts = scripts.filter((script) => script.data.source === 'unofficial');
---

<Layout
	title="NSE Library"
	description="Search and browse official and unofficial Nmap NSE scripts in a static Astro library."
>
	<div class="relative overflow-hidden">
		<div class="absolute inset-x-0 top-0 -z-10 h-[28rem] bg-[radial-gradient(circle_at_top,_rgba(125,211,252,0.12),_transparent_60%)]"></div>

		<header class="mx-auto max-w-7xl px-6 pb-8 pt-16 sm:px-8 lg:px-10">
			<section class="pb-8">
				<div class="w-full">
					<p class="text-xs uppercase tracking-[0.4em] text-cyan-200/80">Nmap Script Reference</p>
					<h1 class="mt-6 text-5xl font-semibold tracking-tight text-white sm:text-6xl">
						Browse Nmap NSE scripts in a faster, cleaner reference library.
					</h1>
					<p class="mt-6 text-base leading-8 text-slate-300">
						Explore official Nmap scripts and community-maintained entries through a focused,
						searchable interface built for quick lookup, comparison, and discovery.
					</p>

					<div class="mt-8 flex flex-wrap gap-3 text-sm text-slate-200">
						<span class="rounded-full border border-cyan-400/20 bg-cyan-400/10 px-4 py-2">
							Official + community scripts
						</span>
						<span class="rounded-full border border-emerald-400/20 bg-emerald-400/10 px-4 py-2">
							Searchable reference
						</span>
						<span class="rounded-full border border-white/10 bg-white/5 px-4 py-2">
							Static by design
						</span>
					</div>
				</div>
				<div class="mt-10 w-full rounded-[2rem] border border-white/10 bg-white/5 p-6 shadow-[0_24px_80px_rgba(2,6,23,0.4)] backdrop-blur">
					<p class="text-xs uppercase tracking-[0.35em] text-slate-400">Search Scripts</p>
					<label class="mt-4 block">
						<span class="sr-only">Search scripts</span>
						<input
							id="script-search"
							type="search"
							placeholder="Search by name, tag, category, or source..."
							class="w-full rounded-2xl border border-white/10 bg-slate-950/80 px-4 py-3 text-sm text-white outline-none ring-0 placeholder:text-slate-500 focus:border-cyan-300"
						/>
					</label>
					<p class="mt-4 text-sm leading-7 text-slate-300">
						Filter scripts by name, category, tag, or source to get to the right entry quickly.
					</p>
					<div class="mt-6 grid gap-3 sm:grid-cols-3">
						<div class="rounded-2xl border border-white/10 bg-slate-950/70 p-4">
							<p class="text-xs uppercase tracking-[0.25em] text-slate-500">Total</p>
							<p class="mt-3 text-3xl font-semibold text-white" data-results-count>{scripts.length}</p>
						</div>
						<div class="rounded-2xl border border-white/10 bg-slate-950/70 p-4">
							<p class="text-xs uppercase tracking-[0.25em] text-slate-500">Official</p>
							<p class="mt-3 text-3xl font-semibold text-white">{officialScripts.length}</p>
						</div>
						<div class="rounded-2xl border border-white/10 bg-slate-950/70 p-4">
							<p class="text-xs uppercase tracking-[0.25em] text-slate-500">Unofficial</p>
							<p class="mt-3 text-3xl font-semibold text-white">{unofficialScripts.length}</p>
						</div>
					</div>
			</section>
		</header>

		<main class="mx-auto max-w-7xl space-y-16 px-6 pb-24 sm:px-8 lg:px-10">
			<div
				id="search-empty"
				class="hidden rounded-[2rem] border border-dashed border-white/15 bg-white/5 p-6 text-sm text-slate-300"
			>
				No scripts match your current search.
			</div>

			<LibrarySection
				id="official"
				title="Official NSE Scripts"
				description="Scripts maintained by the Nmap project and organized for quick browsing."
				emptyMessage="No official scripts are currently listed."
				scripts={officialScripts}
			/>

			<LibrarySection
				id="unofficial"
				title="Unofficial NSE Scripts"
				description="Community-maintained or private scripts collected alongside the official library."
				emptyMessage="No unofficial scripts are currently listed."
				scripts={unofficialScripts}
			/>
		</main>
	</div>

	<script is:inline>
		const input = document.querySelector('#script-search');
		const items = Array.from(document.querySelectorAll('[data-search-item]'));
		const resultsCount = document.querySelector('[data-results-count]');
		const emptyState = document.querySelector('#search-empty');

		const updateResults = () => {
			const query = input instanceof HTMLInputElement ? input.value.trim().toLowerCase() : '';
			let visibleCount = 0;

			for (const item of items) {
				const text = item.getAttribute('data-search-text')?.toLowerCase() ?? '';
				const matches = !query || text.includes(query);

				item.classList.toggle('hidden', !matches);

				if (matches) {
					visibleCount += 1;
				}
			}

			if (resultsCount) {
				resultsCount.textContent = String(visibleCount);
			}

			if (emptyState) {
				emptyState.classList.toggle('hidden', visibleCount !== 0);
			}
		};

		input?.addEventListener('input', updateResults);
		updateResults();
	</script>
</Layout>
