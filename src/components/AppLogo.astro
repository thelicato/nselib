---
interface Props {
	href?: string;
	class?: string;
	size?: 'hero' | 'page';
}

const { href = '/', class: className = '', size = 'hero' } = Astro.props;
const sizeClasses = size === 'hero' ? 'w-full max-w-[380px]' : 'w-full max-w-[320px]';
const imageClasses = size === 'hero' ? 'h-16 w-16' : 'h-14 w-14';
const headingClasses =
	size === 'hero'
		? 'text-3xl sm:text-4xl'
		: 'text-[1.7rem] sm:text-3xl';
---

<a
	href={href}
	class={`inline-flex ${sizeClasses} ${className}`.trim()}
	aria-label="NSE Library home"
>
	<div class="flex w-full items-center justify-center gap-4 rounded-[1.75rem] border-2 border-[#2a7382] bg-[#121b2b] px-5 py-4 shadow-[0_20px_70px_rgba(3,8,20,0.28)]">
		<img
			src="/logo.png"
			alt=""
			class={`block object-contain ${imageClasses}`}
			width={size === 'hero' ? 64 : 56}
			height={size === 'hero' ? 64 : 56}
		/>
		<h1 class={`brand-wordmark ${headingClasses} leading-none text-white`}>
			NSE LIB
		</h1>
	</div>
</a>
