---
import { getCollection } from 'astro:content';
import Fuse from 'fuse.js';

import AppLogo from '../components/AppLogo.astro';
import LibrarySection from '../components/LibrarySection.astro';
import Layout from '../layouts/Layout.astro';

const scripts = (await getCollection('scripts')).sort((a, b) =>
	a.data.title.localeCompare(b.data.title)
);

const officialScripts = scripts.filter((script) => script.data.source === 'official');
const unofficialScripts = scripts.filter((script) => script.data.source === 'unofficial');
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.nselib.com';
const homeJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: 'NSE LIB',
	url: siteUrl,
	description:
		'Browse official and unofficial Nmap NSE scripts in a searchable static reference library.',
	isPartOf: {
		'@type': 'WebSite',
		name: 'NSE LIB',
		url: siteUrl
	},
	about: {
		'@type': 'SoftwareApplication',
		name: 'Nmap',
		applicationCategory: 'SecurityApplication'
	}
};
---

<Layout
	title="NSE Library"
	description="Search and browse official and unofficial Nmap NSE scripts in a static reference library."
	ogType="website"
	jsonLd={homeJsonLd}
>
	<div class="relative overflow-hidden">
		<div class="absolute inset-x-0 top-0 -z-10 h-112 bg-[radial-gradient(circle_at_top,rgba(125,211,252,0.12),transparent_60%)]"></div>

		<header class="mx-auto max-w-7xl px-6 pb-8 pt-8 sm:px-8 lg:px-10">
			<section class="pb-8">
				<div class="w-full text-center">
					<AppLogo class="mx-auto" size="page" />
					<h1 class="hero-display mt-6 text-4xl font-semibold tracking-tight text-white sm:text-5xl">
						Browse Nmap NSE scripts in a faster, <br/> cleaner reference library.
					</h1>
					<p class="mx-auto mt-6 max-w-3xl text-base leading-8 text-slate-300">
						Explore official Nmap scripts and community-maintained entries through a focused,
						searchable interface built for quick lookup, comparison, and discovery.
					</p>

					<div class="mt-8 flex flex-wrap justify-center gap-3 text-sm text-slate-200">
						<span class="rounded-full border border-cyan-400/20 bg-cyan-400/10 px-4 py-2">
							Official + community scripts
						</span>
						<span class="rounded-full border border-emerald-400/20 bg-emerald-400/10 px-4 py-2">
							Searchable reference
						</span>
						<span class="rounded-full border border-white/10 bg-white/5 px-4 py-2">
							Static by design
						</span>
					</div>
				</div>
				<div
					id="search-panel"
					class="mt-10 w-full rounded-4xl border border-white/10 bg-white/5 p-6 shadow-[0_24px_80px_rgba(2,6,23,0.4)] backdrop-blur"
				>
					<div class="flex flex-wrap items-center justify-between gap-3">
						<p class="text-xs uppercase tracking-[0.35em] text-slate-400">Search Scripts</p>
						<div class="flex flex-wrap gap-2 text-xs text-slate-400">
							<span class="rounded-full border border-white/10 bg-slate-950/60 px-3 py-1">/</span>
							<span class="rounded-full border border-white/10 bg-slate-950/60 px-3 py-1">
								Ctrl/Cmd + K
							</span>
						</div>
					</div>
					<label class="mt-4 block">
						<span class="sr-only">Search scripts</span>
						<input
							id="script-search"
							type="search"
							placeholder="Search by name, tag, category, or source..."
							class="w-full rounded-2xl border border-white/10 bg-slate-950/80 px-4 py-3 text-sm text-white outline-none ring-0 placeholder:text-slate-500 focus:border-cyan-300"
						/>
					</label>
					<p class="mt-4 text-sm leading-7 text-slate-300">
						Filter scripts by name, category, tag, or source to get to the right entry quickly.
					</p>
					<div class="mt-5 flex flex-wrap gap-3">
						<button
							type="button"
							class="source-filter rounded-full border border-cyan-400/30 bg-cyan-400/12 px-4 py-2 text-sm font-medium text-cyan-100 transition hover:border-cyan-300/40 hover:bg-cyan-400/18"
							data-filter-source="all"
							aria-pressed="true"
						>
							All Scripts
						</button>
						<button
							type="button"
							class="source-filter rounded-full border border-white/10 bg-slate-950/60 px-4 py-2 text-sm font-medium text-slate-300 transition hover:border-white/20 hover:text-white"
							data-filter-source="official"
							aria-pressed="false"
						>
							Official
						</button>
						<button
							type="button"
							class="source-filter rounded-full border border-white/10 bg-slate-950/60 px-4 py-2 text-sm font-medium text-slate-300 transition hover:border-white/20 hover:text-white"
							data-filter-source="unofficial"
							aria-pressed="false"
						>
							Unofficial
						</button>
					</div>
					<div class="mt-6 grid gap-3 sm:grid-cols-3">
						<div class="rounded-2xl border border-white/10 bg-slate-950/70 p-4">
							<p class="text-xs uppercase tracking-[0.25em] text-slate-500">Total</p>
							<p class="mt-3 text-3xl font-semibold text-white" data-results-count>{scripts.length}</p>
						</div>
						<div class="rounded-2xl border border-white/10 bg-slate-950/70 p-4">
							<p class="text-xs uppercase tracking-[0.25em] text-slate-500">Official</p>
							<p class="mt-3 text-3xl font-semibold text-white">{officialScripts.length}</p>
						</div>
						<div class="rounded-2xl border border-white/10 bg-slate-950/70 p-4">
							<p class="text-xs uppercase tracking-[0.25em] text-slate-500">Unofficial</p>
							<p class="mt-3 text-3xl font-semibold text-white">{unofficialScripts.length}</p>
						</div>
					</div>
				</div>
			</section>
		</header>

		<main class="mx-auto max-w-7xl space-y-16 px-6 pb-24 sm:px-8 lg:px-10">
			<div
				id="search-empty"
				class="hidden rounded-4xl border border-dashed border-white/15 bg-white/5 p-6 text-sm text-slate-300"
			>
				No scripts match your current search.
			</div>

			<LibrarySection
				id="library"
				title="NSE Scripts"
				description="A single catalog of official and unofficial NSE scripts, with source labels on every card for quick scanning."
				emptyMessage="No scripts are currently listed."
				scripts={scripts}
			/>
		</main>
	</div>

	<script>
		import Fuse from 'fuse.js';

		const input = document.querySelector('#script-search');
		const searchPanel = document.querySelector('#search-panel');
		const items = Array.from(document.querySelectorAll('[data-search-item]')).map((item) => {
			return {
				element: item,
				title: item.getAttribute('data-search-title') ?? '',
				description: item.getAttribute('data-search-description') ?? '',
				category: item.getAttribute('data-search-category') ?? '',
				tags: (item.getAttribute('data-search-tags') ?? '').split(' ').filter(Boolean),
				source: item.getAttribute('data-search-group') ?? ''
			};
		});
		const sourceFilters = Array.from(document.querySelectorAll('[data-filter-source]'));
		const resultsCount = document.querySelector('[data-results-count]');
		const emptyState = document.querySelector('#search-empty');
		const loadMoreButton = document.querySelector('#load-more');
		const loadMoreContainer = document.querySelector('#load-more-container');
		const pageSize = 12;
		let visibleLimit = pageSize;
		let activeSource = 'all';
		const fuse = new Fuse(items, {
			includeScore: true,
			threshold: 0.38,
			ignoreLocation: true,
			minMatchCharLength: 2,
			keys: [
				{ name: 'title', weight: 0.45 },
				{ name: 'tags', weight: 0.25 },
				{ name: 'category', weight: 0.15 },
				{ name: 'description', weight: 0.15 }
			]
		});

		const focusSearch = () => {
			if (!(input instanceof HTMLInputElement)) {
				return;
			}

			if (searchPanel instanceof HTMLElement) {
				const topOffset = 16;
				const panelTop = searchPanel.getBoundingClientRect().top + window.scrollY - topOffset;
				window.scrollTo({ top: Math.max(panelTop, 0), behavior: 'smooth' });
			}

			input.focus();
			input.select();
		};

		const updateResults = () => {
			const query = input instanceof HTMLInputElement ? input.value.trim() : '';
			let matchingCount = 0;
			let renderedCount = 0;
			const matchedItems = query ? new Set(fuse.search(query).map((result) => result.item)) : null;

			for (const item of items) {
				const matchesQuery = !matchedItems || matchedItems.has(item);
				const matchesSource = activeSource === 'all' || item.source === activeSource;
				const matches = matchesQuery && matchesSource;

				if (matches) {
					matchingCount += 1;
				}

				const shouldShow = matches && renderedCount < visibleLimit;
				item.element.classList.toggle('hidden', !shouldShow);
				item.element.setAttribute('data-visible', String(shouldShow));

				if (shouldShow) {
					renderedCount += 1;
				}
			}

			if (resultsCount) {
				resultsCount.textContent = String(matchingCount);
			}

			if (emptyState) {
				emptyState.classList.toggle('hidden', matchingCount !== 0);
			}

			if (loadMoreContainer) {
				loadMoreContainer.classList.toggle('hidden', matchingCount <= visibleLimit);
				loadMoreContainer.classList.toggle('flex', matchingCount > visibleLimit);
			}
		};

		document.addEventListener('keydown', (event) => {
			if (!(input instanceof HTMLInputElement)) {
				return;
			}

			const target = event.target;
			const isTypingTarget =
				target instanceof HTMLInputElement ||
				target instanceof HTMLTextAreaElement ||
				target instanceof HTMLSelectElement ||
				(target instanceof HTMLElement && target.isContentEditable);

			const pressedSlash = event.key === '/' && !event.metaKey && !event.ctrlKey && !event.altKey;
			const pressedCommandPalette =
				event.key.toLowerCase() === 'k' && (event.metaKey || event.ctrlKey);

			if (!pressedSlash && !pressedCommandPalette) {
				return;
			}

			if (isTypingTarget && target !== input) {
				return;
			}

			event.preventDefault();
			focusSearch();
		});

		for (const filter of sourceFilters) {
			filter.addEventListener('click', () => {
				activeSource = filter.getAttribute('data-filter-source') ?? 'all';
				visibleLimit = pageSize;

				for (const button of sourceFilters) {
					const isActive = button === filter;
					button.setAttribute('aria-pressed', String(isActive));
					button.classList.toggle('border-cyan-400/30', isActive);
					button.classList.toggle('bg-cyan-400/12', isActive);
					button.classList.toggle('text-cyan-100', isActive);
					button.classList.toggle('border-white/10', !isActive);
					button.classList.toggle('bg-slate-950/60', !isActive);
					button.classList.toggle('text-slate-300', !isActive);
				}

				updateResults();
			});
		}

		loadMoreButton?.addEventListener('click', () => {
			visibleLimit += pageSize;
			updateResults();
		});

		input?.addEventListener('input', () => {
			visibleLimit = pageSize;
			updateResults();
		});
		updateResults();
	</script>
</Layout>
