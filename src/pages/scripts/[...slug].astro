---
import fs from 'node:fs/promises';
import path from 'node:path';
import { getCollection, render } from 'astro:content';

import AppLogo from '../../components/AppLogo.astro';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const scripts = await getCollection('scripts');

	return scripts.map((script) => ({
		params: { slug: script.id },
		props: { script }
	}));
}

const { script } = Astro.props;
const { Content } = await render(script);
let scriptSource = '';

try {
	scriptSource = await fs.readFile(
		path.resolve('src/data/script-source', `${script.id}.nse`),
		'utf8'
	);
} catch {
	scriptSource = '';
}

const riskTone = {
	safe: 'border-emerald-400/30 bg-emerald-400/10 text-emerald-100',
	informational: 'border-sky-400/30 bg-sky-400/10 text-sky-100',
	intrusive: 'border-amber-400/30 bg-amber-400/10 text-amber-100'
}[script.data.risk];

const sourceLabel = script.data.source === 'official' ? 'Official' : 'Unofficial';
const hasUsage = script.data.usage.trim().length > 0;
---

<Layout
	title={`${script.data.title} | NSE Library`}
	description={script.data.shortDescription}
>
	<div class="mx-auto max-w-7xl px-6 py-8 sm:px-8 lg:px-10">
		<div class="flex justify-center">
			<AppLogo size="page" />
		</div>

		<div class="mt-8">
			<a
				class="inline-flex items-center gap-3 rounded-full border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-medium text-slate-100 shadow-[0_12px_40px_rgba(2,6,23,0.25)] transition hover:border-cyan-300/30 hover:bg-cyan-400/10 hover:text-white"
				href="/"
			>
				<span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-slate-950/80 text-cyan-200" aria-hidden="true">
					<svg viewBox="0 0 16 16" class="h-3.5 w-3.5 fill-none stroke-current" xmlns="http://www.w3.org/2000/svg">
						<path d="M10.5 3.5L6 8L10.5 12.5" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</span>
				Back to library
			</a>
		</div>

		<section class="mt-8 rounded-[2.25rem] border border-white/10 bg-white/5 p-8 shadow-[0_24px_80px_rgba(2,6,23,0.4)] backdrop-blur">
			<div class="flex flex-wrap items-center gap-3">
				<span class="rounded-full border border-white/10 bg-slate-950/70 px-3 py-1 text-xs uppercase tracking-[0.3em] text-slate-300">
					{sourceLabel}
				</span>
				<span class={`rounded-full border px-3 py-1 text-xs font-medium ${riskTone}`}>
					{script.data.risk}
				</span>
				<span class="rounded-full border border-white/10 bg-slate-950/70 px-3 py-1 text-xs text-slate-300">
					{script.data.category}
				</span>
			</div>

			<h1 class="mt-6 text-4xl font-semibold tracking-tight text-white sm:text-5xl">
				{script.data.title}
			</h1>
			<p class="mt-5 max-w-3xl text-base leading-8 text-slate-300">
				{script.data.shortDescription}
			</p>

			<div class="mt-8 grid gap-4 md:grid-cols-3">
				<div class="rounded-2xl border border-white/10 bg-slate-950/70 p-5">
					<p class="text-xs uppercase tracking-[0.25em] text-slate-500">Ports</p>
					<p class="mt-3 text-lg text-white">{script.data.ports.join(', ') || 'Any'}</p>
				</div>
				<div class="rounded-2xl border border-white/10 bg-slate-950/70 p-5">
					<p class="text-xs uppercase tracking-[0.25em] text-slate-500">Protocols</p>
					<p class="mt-3 text-lg text-white">{script.data.protocols.join(', ') || 'n/a'}</p>
				</div>
				<div class="rounded-2xl border border-white/10 bg-slate-950/70 p-5">
					<p class="text-xs uppercase tracking-[0.25em] text-slate-500">Attribution</p>
					<p class="mt-3 text-lg text-white">{script.data.author}</p>
				</div>
			</div>

			<div class="mt-8 rounded-4xl border border-white/10 bg-slate-950/70 p-6">
				<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
					<div>
						<h2 class="text-xl font-semibold text-white">Usage</h2>
						<p class="mt-2 text-sm leading-7 text-slate-400">
							{
								hasUsage
									? 'Copy the command and adjust the target or script arguments as needed.'
									: 'No example usage is currently available for this script entry.'
							}
						</p>
					</div>
					{
						hasUsage && (
							<button
								type="button"
								id="copy-usage"
								data-copy-text={script.data.usage}
								class="inline-flex items-center justify-center gap-2 rounded-2xl border border-cyan-400/25 bg-cyan-400/12 px-4 py-3 text-sm font-medium text-cyan-100 transition hover:border-cyan-300/40 hover:bg-cyan-400/18 hover:text-white"
							>
								Copy command
							</button>
						)
					}
				</div>
				{
					hasUsage ? (
						<pre class="mt-5 overflow-x-auto rounded-2xl border border-white/10 bg-slate-950/80 p-4 text-sm leading-7 text-cyan-100"><code>{script.data.usage}</code></pre>
					) : (
						<div class="mt-5 rounded-2xl border border-dashed border-white/10 bg-slate-950/50 p-4 text-sm text-slate-400">
							Example usage has not been added for this script yet.
						</div>
					)
				}
			</div>
		</section>

		{
			scriptSource && (
				<details class="mt-8 rounded-4xl border border-white/10 bg-white/5 p-6 shadow-[0_24px_80px_rgba(2,6,23,0.32)] backdrop-blur">
					<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold text-white marker:hidden">
						<span>Script Source</span>
						<span class="inline-flex items-center justify-center rounded-2xl border border-cyan-400/25 bg-cyan-400/12 px-4 py-2 text-sm font-medium text-cyan-100">
							Toggle
						</span>
					</summary>
					<p class="mt-4 text-sm leading-7 text-slate-400">
						The full script source is stored with this entry and is hidden by default to keep
						the page easier to scan.
					</p>
					<pre class="mt-5 overflow-x-auto rounded-2xl border border-white/10 bg-slate-950/80 p-4 text-sm leading-7 text-cyan-100"><code>{scriptSource}</code></pre>
				</details>
			)
		}

		<div class="mt-8 grid items-start gap-8 lg:grid-cols-5">
			<article class="rounded-4xl border border-white/10 bg-white/5 p-8 shadow-[0_24px_80px_rgba(2,6,23,0.32)] backdrop-blur lg:col-span-3">
				<h2 class="text-2xl font-semibold text-white">Overview</h2>
				<div class="content-copy mt-6 max-w-none text-slate-300">
					<Content />
				</div>
			</article>

			<aside class="space-y-6 lg:col-span-2">
				{
					(script.data.reference || script.data.documentationUrl) && (
						<section class="rounded-4xl border border-white/10 bg-white/5 p-6 shadow-[0_24px_80px_rgba(2,6,23,0.32)] backdrop-blur">
							<h2 class="text-xl font-semibold text-white">References</h2>
							<div class="mt-4 flex flex-col gap-3">
								{script.data.reference && (
									<a
										class="inline-flex items-center justify-center gap-2 rounded-2xl border border-cyan-400/25 bg-cyan-400/12 px-4 py-3 text-sm font-medium text-cyan-100 transition hover:border-cyan-300/40 hover:bg-cyan-400/18 hover:text-white"
										href={script.data.reference.url}
										target="_blank"
										rel="noreferrer"
									>
										{script.data.reference.label}
									</a>
								)}
								{script.data.documentationUrl && (
									<a
										class="inline-flex items-center justify-center gap-2 rounded-2xl border border-white/10 bg-slate-950/60 px-4 py-3 text-sm font-medium text-slate-100 transition hover:border-white/20 hover:text-white"
										href={script.data.documentationUrl}
										target="_blank"
										rel="noreferrer"
									>
										View NSEDoc Page
									</a>
								)}
							</div>
						</section>
					)
				}

				<section class="rounded-4xl border border-white/10 bg-white/5 p-6 shadow-[0_24px_80px_rgba(2,6,23,0.32)] backdrop-blur">
					<h2 class="text-xl font-semibold text-white">Tags</h2>
					<div class="mt-4 flex flex-wrap gap-2">
						{script.data.tags.map((tag) => (
							<span class="rounded-full border border-cyan-400/20 bg-cyan-400/10 px-3 py-1 text-xs text-cyan-100">
								#{tag}
							</span>
						))}
					</div>
				</section>

				<section class="rounded-4xl border border-white/10 bg-white/5 p-6 shadow-[0_24px_80px_rgba(2,6,23,0.32)] backdrop-blur">
					<h2 class="text-xl font-semibold text-white">Output Preview</h2>
					<ul class="mt-4 space-y-3 text-sm leading-7 text-slate-300">
						{script.data.outputPreview.map((line) => (
							<li class="rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3">{line}</li>
						))}
					</ul>
				</section>
			</aside>
		</div>
	</div>

	<script is:inline>
		const copyButton = document.querySelector('#copy-usage');

		copyButton?.addEventListener('click', async () => {
			if (!(copyButton instanceof HTMLButtonElement)) {
				return;
			}

			const copyText = copyButton.getAttribute('data-copy-text') ?? '';
			const originalLabel = copyButton.textContent?.trim() ?? 'Copy command';

			try {
				await navigator.clipboard.writeText(copyText);
				copyButton.textContent = 'Copied';
			} catch {
				copyButton.textContent = 'Copy failed';
			}

			window.setTimeout(() => {
				copyButton.textContent = originalLabel;
			}, 1800);
		});
	</script>
</Layout>
